{
  "manifest_version": 3,
  "name": "Polash AI OS — Quick Access",
  "short_name": "Polash OS",
  "version": "1.0.0",
  "description": "One-click access to the Polash AI OS dashboard, 500+ AI tools, Insights articles, workspace and contact.",
  "homepage_url": "https://mipolash-prog.github.io/polash-ai-os/",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Polash AI OS",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mipolash-prog.github.io/polash-ai-os/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
