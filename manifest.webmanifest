  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "AI Tools", "url": "./index.html#tools", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Dashboard", "url": "./index.html#dashboard", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "YouTube Hub", "url": "./index.html#youtube", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Insights", "url": "./index.html#blog", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Settings", "url": "./index.html#settings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Contact", "url": "./index.html#contact", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
